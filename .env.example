DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*

DATABASE_NAME=nexucon
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password-here
DATABASE_HOST=localhost
DATABASE_PORT=5432

REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Frontend URL used in emails/links. Use http://localhost:3000 during development.
FRONTEND_URL=http://localhost:3000

# Resend transactional email
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Nexucon Email notifications <notifications@your-domain.com>

# Cloudflare R2 Storage for BIM & Documents
STORAGE_PROVIDER=cloudflare_r2
CLOUDFLARE_R2_BUCKET_NAME=your-bucket
CLOUDFLARE_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_API_URL=https://<account-id>.r2.cloudflarestorage.com/your-bucket
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key

# Google Cloud Service Account - Translation API
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=your-project-id
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=sa@your-project-id.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=apis/your-service-account.json

# Google Cloud Service Account - Google Meet & Calendar API
# The private key must be a single line with \n escapes.
GOOGLE_MEETING_PROJECT_ID=your-project-id
GOOGLE_MEETING_CLIENT_EMAIL=sa@your-project-id.iam.gserviceaccount.com
GOOGLE_MEETING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (site photos)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Other integrations
TERSUS_API_URL=https://api.tersus.gnss
TERSUS_API_KEY=placeholder

AUTODESK_CLIENT_ID=placeholder
AUTODESK_CLIENT_SECRET=placeholder

TRIMBLE_CLIENT_ID=placeholder
TRIMBLE_CLIENT_SECRET=placeholder

SENTRY_DSN=placeholder

GEMINI_API_KEY=placeholder
GEMINI_MODEL=gemini-3.5-flash-lite
