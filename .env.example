# ======================================================================
# Nexucon backend environment configuration — VARIABLE NAMES ONLY.
# Copy to .env and fill in real values. Never commit real credentials.
# ======================================================================

# --- Core Django -------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Force HTTPS redirect + HSTS in production (defaults on when unset)
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SECURE_HSTS_PRELOAD=

# --- Database (PostgreSQL) --------------------------------------------
# Either a single DATABASE_URL or the discrete variables below.
DATABASE_URL=
DATABASE_ENGINE=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
# Set to true only when PostGIS/GDAL are installed on the server.
ENABLE_GIS=

# --- Celery / Redis (background tasks, Celery beat, Channels layer) ----
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Run tasks synchronously in-process (development/tests only)
CELERY_TASK_ALWAYS_EAGER=

# --- Frontend ----------------------------------------------------------
# Used in emails/links and to build CORS/CSRF allowlists. Comma-separated.
FRONTEND_URL=

# --- Resend (transactional email) --------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Cloudflare R2 (BIM, documents, scan files) ------------------------
# STORAGE_PROVIDER=cloudflare_r2 enables R2 as the default Django storage
STORAGE_PROVIDER=
# CLOUDFLARE_R2_ACCOUNT_ID is preferred; CLOUDFLARE_ACCOUNT_ID is a legacy alias.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# --- Cloudinary (report artifacts, site photos) -------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional sub-folder prefix for uploaded Cloudinary assets
CLOUDINARY_FOLDER=

# --- Google Cloud service account --------------------------------------
# Path to the service-account JSON (Translation API etc.)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=
# Google Meet & Calendar API (SA key inline; private key on ONE line with \n escapes)
GOOGLE_MEETING_PROJECT_ID=
GOOGLE_MEETING_CLIENT_EMAIL=
GOOGLE_MEETING_PRIVATE_KEY=

# --- Trimble Connect (BIM integration, OAuth 2.0 + PKCE) ----------------
# Obtain from the Trimble Developer Console. Redirect URI must be the
# backend's /api/v1/digital-eye/trimble/connections/{id}/callback/ endpoint.
TRIMBLE_CLIENT_ID=
TRIMBLE_CLIENT_SECRET=
TRIMBLE_REDIRECT_URI=
# Defaults below are the public Trimble Connect endpoints; override only if
# Trimble provides different URLs for your integration.
TRIMBLE_AUTHORIZE_URL=
TRIMBLE_TOKEN_URL=
TRIMBLE_API_BASE=
# Target Trimble Connect project + folder for inspection-file sync
# (defect CSV, inspection summary, AI overlay GeoJSON).
TRIMBLE_PROJECT_ID=
TRIMBLE_FOLDER_ID=

# --- Email delivery -------------------------------------------------------
# Provider selector for the email channel (e.g. resend). Defaults to Resend.
EMAIL_PROVIDER_TYPE=

# --- Tersus GNSS receivers (Digital Eye) --------------------------------
TERSUS_API_URL=
TERSUS_API_KEY=

# --- Government inter-agency APIs (CAC / e-GIS / LASRRA / FMW) -----------
# Bearer tokens issued by each agency for the inter-agency verification
# bridge. Until set, regulatory entity lookups honestly report
# PENDING_CREDENTIALS instead of fabricating verification results.
GOV_CAC_API_TOKEN=
GOV_EGIS_API_TOKEN=
GOV_LASRRA_API_TOKEN=
GOV_FMW_API_TOKEN=
# CAC data-portal OAuth client credentials (client-credentials flow). The
# token-exchange + verification endpoints are not yet documented by the
# agency — stored here until the API documentation is supplied.
GOV_CAC_CLIENT_ID=
GOV_CAC_CLIENT_SECRET=

# --- Autodesk Platform Services (RVT -> IFC model derivative) -----------
AUTODESK_CLIENT_ID=
AUTODESK_CLIENT_SECRET=

# --- AI adapters ---------------------------------------------------------
# Every provider below is OPTIONAL and independent. AIService attempts each
# configured provider in turn and uses the first that answers, so one
# provider being down, rate-limited or out of credit never stops the others.
# With no key set, deterministic analysis still runs and no AI narrative is
# produced — the platform never fabricates a finding to fill the gap.
#
# Which providers can serve which call:
#   vision (defect / thermal / delamination detection) — OpenAI, Gemini, Anthropic
#   text   (structured synthesis, recommendations)     — OpenAI, Gemini, Anthropic, DeepSeek
# DeepSeek has no vision endpoint, so it is text-only. This is derived from
# the code, not a separate setting.

GEMINI_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (Claude). The default model is the most capable current one.
# NOTE the NEXUCON_ prefix on the variables below. The bare names
# ANTHROPIC_BASE_URL / ANTHROPIC_MODEL / ANTHROPIC_API_KEY are read by other
# tooling on a developer machine (the Claude Code CLI sets the first two for
# its own routing), and the service deliberately does not read them — an
# unprefixed lookup could redirect these requests, and the key on them, to a
# host nobody chose. A Django setting of the same name still takes priority.
NEXUCON_ANTHROPIC_API_KEY=
NEXUCON_ANTHROPIC_MODEL=claude-opus-5
NEXUCON_ANTHROPIC_BASE_URL=https://api.anthropic.com
NEXUCON_ANTHROPIC_MAX_TOKENS=8192

# DeepSeek (OpenAI-compatible API, so it reuses the OpenAI SDK).
NEXUCON_DEEPSEEK_API_KEY=
NEXUCON_DEEPSEEK_MODEL=deepseek-chat
NEXUCON_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Which provider is tried FIRST. The remaining configured providers follow,
# so an explicit choice is still honoured.
AI_PROVIDER=gemini

# Optional: override the order of the remaining providers after the first.
# Comma-separated, e.g. AI_PROVIDER_ORDER=anthropic,deepseek,openai
AI_PROVIDER_ORDER=

# Retries per provider, and the wall-clock ceiling for one call's whole
# provider chain. With four providers each retrying, an unbounded chain could
# stack four full timeout sequences; the deadline stops it starting another
# provider once the budget is spent. 0 disables the deadline.
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=60
AI_FAILOVER_DEADLINE_SECONDS=300

# --- Optional: FCM push notifications ------------------------------------
# FCM uses the Google service account above (GOOGLE_MEETING_* keys) to mint
# OAuth tokens for the FCM HTTP v1 API — no separate credential needed, but
# the SA must be granted the Firebase Cloud Messaging API role.

# --- Optional: Sentry ----------------------------------------------------
SENTRY_DSN=

# --- Optional: CORS -------------------------------------------------------
# Only for initial frontend bring-up; never enable in production.
CORS_ALLOW_ALL_ORIGINS=
